     "probes": ["tidy_config_gen", "sanitizer_cmd"], "cites": ["clang docs", "llvm sanitizer api", "cse P.8/P.10"]},
    {"id": "performance-cache", "priority": 6, "title": "Performance and cache locality",
     "keywords": ["cache", "locality", "soa", "aos", "alignment", "false sharing", "branch predictor", "profile", "benchmark", "perf", "reserve", "allocation", "arena", "string_view", "vectorization", "aliasing"],
