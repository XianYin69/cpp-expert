{
  "skill": "cpp-expert",
  "standards": ["C++11", "C++14", "C++17", "C++20", "C++23"],
  "note": "12-leaf knowledge tree. Each leaf maps to asset/knowledge/<id>.md and asset/checklists/<id>.md. Lower priority is judged first (correctness before style).",
  "leaves": [
    {"id": "raii-ownership", "priority": 1, "title": "RAII and ownership modelling",
     "keywords": ["unique_ptr", "shared_ptr", "weak_ptr", "new", "delete", "make_unique", "make_shared", "ownership", "not_null", "span", "leak", "dangling", "enable_shared_from_this", "deleter", "raii"],
     "probes": ["ownership_audit", "sanitizer_cmd"], "cites": ["cppref", "cse R.3/R.11/R.32", "book EMC 18-22"]},
    {"id": "special-members", "priority": 2, "title": "Rule of 0/3/5 and special members",
     "keywords": ["destructor", "copy constructor", "move constructor", "operator=", "rule of zero", "rule of three", "rule of five", "= delete", "= default", "self assignment", "swap", "noexcept move"],
     "probes": ["const_audit"], "cites": ["cppref", "cse C.66/C.67", "book EC Item 3"]},
    {"id": "const-move", "priority": 3, "title": "const correctness and move semantics",
     "keywords": ["const", "constexpr", "consteval", "constinit", "mutable", "std::move", "forward", "perfect forwarding", "universal reference", "string_view", "copy elision", "nrvo", "noexcept", "const overload"],
     "probes": ["const_audit"], "cites": ["cppref", "cse Con.1/Con.4", "book EMC 26-30"]},
    {"id": "templates-concepts", "priority": 4, "title": "Templates, concepts, overload resolution",
     "keywords": ["template", "concepts", "requires", "sfinae", "enable_if", "specialization", "adl", "two phase lookup", "ctad", "deduction guide", "overload resolution", "static_assert", "variadic", "if constexpr"],
     "probes": ["template_gen"], "cites": ["cppref", "cse T.1/T.43", "book Templates"]},
    {"id": "stl-algorithms", "priority": 5, "title": "STL containers, iterators, algorithms",
     "keywords": ["vector", "deque", "list", "map", "unordered_map", "set", "array", "span", "string_view", "algorithm", "ranges", "iterator invalidation", "reserve", "emplace", "sort", "binary_search", "stable_sort", "predicate"],
     "probes": ["perf_advice", "ownership_audit"], "cites": ["cppref", "cse SL.1/SL.6", "book EMC Item 21"]},
    {"id": "concurrency-memory-model", "priority": 1, "title": "Concurrency and the memory model",
     "keywords": ["mutex", "scoped_lock", "lock_guard", "unique_lock", "shared_mutex", "recursive_mutex", "atomic", "memory_order", "happens-before", "data race", "deadlock", "condition_variable", "thread", "async", "promise", "future", "jthread", "stop_token", "coroutine", "false sharing", "tsan"],
     "probes": ["concurrency_probe", "sanitizer_cmd"], "cites": ["cppref", "std intro.multithread", "book CPP2 2nd ed Ch.8-9"]},
    {"id": "exception-safety", "priority": 2, "title": "Exception safety and error handling",
     "keywords": ["throw", "noexcept", "try", "catch", "strong guarantee", "basic guarantee", "copy and swap", "expected", "error_code", "terminate", "unwinding", "destructor throw", "error handling"],
     "probes": ["ub_scan", "const_audit"], "cites": ["cppref", "cse E.6/E.15/E.16", "book HAC Item 29"]},
    {"id": "headers-modules", "priority": 4, "title": "Headers, compilation firewall and modules",
     "keywords": ["header", "include", "pimpl", "forward declaration", "odr", "inline", "translation unit", "compile time", "module", "import", "internal linkage", "anonymous namespace", "precompiled header", "circular dependency", "iwyu"],
     "probes": ["tidy_config_gen", "cmake_probe"], "cites": ["cppref", "cse SF.1/SF.7/SF.11"]},
    {"id": "build-systems", "priority": 5, "title": "Build systems and package management",
